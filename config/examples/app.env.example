# Black Gold core configuration (FAKE example values). Copy to a local .env that is never committed.
# Every variable is optional except where noted; defaults are listed. Schema: config/schema/app.schema.json

# Operating mode. Only RESEARCH, BACKTEST, SHADOW, PAPER are loadable in this build.
# LIVE_MANUAL and LIVE_LIMITED are refused at startup: live modes are absent by construction.
BLACKGOLD_MODE=RESEARCH

# Mutable state root. Umbrel mounts ${APP_DATA_DIR}/data at /data.
BLACKGOLD_DATA_DIR=./data
# Derived defaults: ${BLACKGOLD_DATA_DIR}/blackgold.sqlite, /artifacts, /backups
# BLACKGOLD_DB_PATH=./data/blackgold.sqlite
# BLACKGOLD_ARTIFACTS_DIR=./data/artifacts
# BLACKGOLD_BACKUPS_DIR=./data/backups

# Display-only time zone and exchange calendar. Decisions use UTC and the exchange calendar, never Chicago time.
BLACKGOLD_TIMEZONE_DISPLAY=America/Chicago
BLACKGOLD_EXCHANGE=XNYS

# Scheduler poll interval in seconds (5-3600).
BLACKGOLD_SCHEDULER_POLL_SECONDS=60

# Local read-only status listener for `serve` (Umbrel app_proxy routes to it; never exposed directly).
BLACKGOLD_HTTP_PORT=8479

# Notifications: "stub" (in-memory + ledger) or "ntfy" (validated only in Phase 0; delivery is Phase 5).
BLACKGOLD_NOTIFY_ADAPTER=stub
# BLACKGOLD_NTFY_TOPIC_URL=https://ntfy.example.invalid/blackgold-fake-topic

# LLM spend budgets in USD as decimal strings. No model calls exist in Phase 0.
BLACKGOLD_LLM_BUDGET_PER_CALL_USD=0.50
BLACKGOLD_LLM_BUDGET_PER_DAY_USD=5.00
BLACKGOLD_LLM_BUDGET_PER_MONTH_USD=60.00

# The single sleeve account. Role must be exactly blackgold_sleeve; any other value is rejected.
# accountRef is an opaque local reference, never a broker credential. UNASSIGNED until a broker phase.
BLACKGOLD_SLEEVE_ACCOUNT_ROLE=blackgold_sleeve
BLACKGOLD_SLEEVE_ACCOUNT_REF=UNASSIGNED

# Public data sources (Phase 1). Credentials are secrets: set them in the Umbrel app environment, never in git.
# SEC fair access requires a declared User-Agent with a contact address. Required before any EDGAR fetch.
BLACKGOLD_SEC_USER_AGENT_CONTACT=operator@example.invalid
# FRED/ALFRED free API key (https://fred.stlouisfed.org/docs/api/api_key.html). Required before any FRED fetch.
# BLACKGOLD_FRED_API_KEY=replace-with-your-key
# Alpaca market data keys (paper account keys work for the data API). Feed is IEX on the free entitlement.
# BLACKGOLD_ALPACA_KEY_ID=replace-with-your-key-id
# BLACKGOLD_ALPACA_SECRET_KEY=replace-with-your-secret
# Tiingo EOD daily-bars token (https://www.tiingo.com/, free tier). Deeper daily history than Alpaca's free IEX
# feed; required before any `ingest tiingo-bars` fetch. Read-only market data, no brokerage account.
# BLACKGOLD_TIINGO_API_KEY=replace-with-your-token
# Processing-delay overrides by source-id prefix (ISO-8601 durations), applied to every decision-time read:
# a row is visible only when availableAt + delay <= decisionAt. Defaults: 15 min for sec./market./alpaca./
# corporate_action., 60 min for fred./cftc./treasury./bls./bea. Longer is more conservative.
# BLACKGOLD_PROCESSING_DELAYS=fred.=PT2H,cftc.=P1D
# Raw artifact store cap in bytes (default 40 GiB). Every write is checked; ingestion stops at the cap and audit data is never deleted.
# BLACKGOLD_ARTIFACT_BUDGET_BYTES=42949672960
