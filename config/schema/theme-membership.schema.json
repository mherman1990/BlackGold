{
  "$id": "https://blackgold.local/config/schema/theme-membership.schema.json",
  "title": "blackgold theme-membership",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "maxAggregateThemeWeightPct": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "maxHoldingsAgeDays": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "issuers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbols": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "themes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "symbols",
          "themes"
        ]
      }
    }
  },
  "required": [
    "asOf",
    "maxAggregateThemeWeightPct",
    "maxHoldingsAgeDays",
    "issuers"
  ]
}
