{
  "$id": "https://blackgold.local/config/schema/financial-picture.schema.json",
  "title": "blackgold financial-picture",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "staleAfterDays": {
      "default": 120,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "liquidInvestableAssetsUsd": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "blackgold_sleeve",
              "read_only"
            ]
          },
          "taxType": {
            "type": "string",
            "enum": [
              "taxable",
              "traditional_ira",
              "roth_ira",
              "401k",
              "hsa",
              "cash",
              "other"
            ]
          },
          "valueUsd": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "exposures": {
            "default": {
              "assetClass": {},
              "sector": {},
              "style": {}
            },
            "type": "object",
            "properties": {
              "assetClass": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              },
              "sector": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              },
              "style": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          }
        },
        "required": [
          "accountId",
          "label",
          "role",
          "taxType",
          "valueUsd"
        ]
      }
    },
    "careerSensitivity": {
      "default": {
        "sectorFlags": [],
        "themeFlags": [],
        "notes": ""
      },
      "type": "object",
      "properties": {
        "sectorFlags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "themeFlags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "default": "",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "asOf",
    "liquidInvestableAssetsUsd",
    "accounts"
  ]
}
