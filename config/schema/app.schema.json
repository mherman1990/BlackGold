{
  "$id": "https://blackgold.local/config/schema/app.schema.json",
  "title": "blackgold app",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "default": "RESEARCH",
      "type": "string",
      "enum": [
        "RESEARCH",
        "BACKTEST",
        "SHADOW",
        "PAPER",
        "LIVE_MANUAL",
        "LIVE_LIMITED"
      ]
    },
    "dataDir": {
      "default": "./data",
      "type": "string",
      "minLength": 1
    },
    "dbPath": {
      "type": "string",
      "minLength": 1
    },
    "artifactsDir": {
      "type": "string",
      "minLength": 1
    },
    "backupsDir": {
      "type": "string",
      "minLength": 1
    },
    "timezoneDisplay": {
      "default": "America/Chicago",
      "type": "string",
      "const": "America/Chicago"
    },
    "exchange": {
      "default": "XNYS",
      "type": "string",
      "const": "XNYS"
    },
    "schedulerPollSeconds": {
      "default": 60,
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "httpPort": {
      "default": 8479,
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "notifications": {
      "default": {
        "adapter": "stub"
      },
      "type": "object",
      "properties": {
        "adapter": {
          "default": "stub",
          "type": "string",
          "enum": [
            "stub",
            "ntfy"
          ]
        },
        "ntfyTopicUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "budgets": {
      "default": {
        "llmPerCallUsd": "0.50",
        "llmPerDayUsd": "5.00",
        "llmPerMonthUsd": "60.00"
      },
      "type": "object",
      "properties": {
        "llmPerCallUsd": {
          "default": "0.50",
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "llmPerDayUsd": {
          "default": "5.00",
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "llmPerMonthUsd": {
          "default": "60.00",
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        }
      }
    },
    "sources": {
      "default": {
        "processingDelays": {},
        "artifactBudgetBytes": 42949672960
      },
      "type": "object",
      "properties": {
        "secUserAgentContact": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "fredApiKey": {
          "type": "string",
          "minLength": 8
        },
        "alpacaKeyId": {
          "type": "string",
          "minLength": 8
        },
        "alpacaSecretKey": {
          "type": "string",
          "minLength": 8
        },
        "processingDelays": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^P(T\\d+[HMS]|\\d+D)"
          }
        },
        "artifactBudgetBytes": {
          "default": 42949672960,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sleeveAccount": {
      "default": {
        "role": "blackgold_sleeve",
        "accountRef": "UNASSIGNED"
      },
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "blackgold_sleeve"
        },
        "accountRef": {
          "default": "UNASSIGNED",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role"
      ]
    }
  }
}
